# dependencies
node_modules/
**/node_modules/

# build outputs
dist/
build/
.next/
out/
coverage/
.vite/

# environment files - never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/

# TypeScript cache
*.tsbuildinfo

# Prisma
# keep schema and migrations, ignore local sqlite/db files if any
*.db
*.db-journal
*.sqlite
*.sqlite3

# PostgreSQL/database backups
*.dump
*.backup
*.sql.gz
*.tar
backups/
**/backups/
apps/api/backups/

# uploads/local storage if added later
uploads/
**/uploads/

# temporary files
tmp/
temp/
.cache/

# local certificates/secrets
*.pem
*.key
*.crt
credentials.json
token.json
google-credentials.json
google-token.json

# Docker/local volumes
docker-data/
.pgdata/
postgres-data/
redis-data/