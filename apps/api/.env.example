NODE_ENV="development"

DATABASE_URL="mysql://baura_user:baura_password@localhost:3306/baura_erp"

JWT_SECRET="replace_with_a_random_secret_of_at_least_64_characters"
JWT_EXPIRES_IN="4h"

PORT="4000"

FRONTEND_URL="http://localhost:5173"

# Official Baura website Laravel backend.
# Local example assumes php artisan serve uses port 8000.
OFFICIAL_SITE_API_URL="http://127.0.0.1:8000"

# Must exactly match ERP_INTEGRATION_TOKEN in the Laravel backend.
# Server-side secret only. Never put this in VITE_* variables.
ERP_INTEGRATION_TOKEN="replace_with_the_same_secure_integration_token_used_by_laravel"

LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="10"

MYSQLDUMP_PATH="/usr/local/bin/mysqldump"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/settings/google-drive/callback"