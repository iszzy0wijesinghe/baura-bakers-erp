generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PackageUnit {
  G
  KG
  ML
  L
  UNIT
}

enum BaseUnit {
  G
  ML
  UNIT
}

enum StockMovementType {
  PURCHASE
  PRODUCTION
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

enum FinishedGoodsMovementType {
  PRODUCTION
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  VOID
}

enum ProductionStatus {
  DRAFT
  POSTED
  VOID
}

enum SaleType {
  POS
  MANUAL
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BackupFrequency {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupTarget {
  LOCAL
  GOOGLE_DRIVE
}

enum BackupStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum PosApprovalType {
  MANUAL_DISCOUNT
  CANCEL_SALE
  REFUND
  RETURN
}

enum PosApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  EXPIRED
}

enum PosSessionStatus {
  OPEN
  CLOSING
  PENDING_APPROVAL
  CLOSED
}

enum PosPaymentStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PosCashMovementType {
  OPENING_FLOAT
  CASH_IN
  CASH_OUT
  REFUND
  ADJUSTMENT
}

enum PosCountType {
  OPENING
  CLOSING
}

enum DayEndStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BusinessCalendarExceptionType {
  CLOSED
  SPECIAL_HOURS
}

enum ReceiptEmailStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

model User {
  id                 String   @id @default(uuid()) @db.Char(36)
  officialSiteUserId Int?     @unique
  firstName          String
  lastName           String
  email              String   @unique
  passwordHash       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles                    UserRole[]
  purchaseCarters          PurchaseCarter[]  @relation("CarterCreatedBy")
  salesOrders              SalesOrder[]      @relation("SaleCreatedBy")
  goodsReceiptsCreated     GoodsReceipt[]    @relation("GoodsReceiptCreatedBy")
  goodsReceiptsPosted      GoodsReceipt[]    @relation("GoodsReceiptPostedBy")
  productionBatchesCreated ProductionBatch[] @relation("ProductionCreatedBy")
  productionBatchesPosted  ProductionBatch[] @relation("ProductionPostedBy")
  auditLogs                AuditLog[]

  posApprovalsRequested PosApproval[] @relation("PosApprovalRequestedBy")
  posApprovalsApproved  PosApproval[] @relation("PosApprovalApprovedBy")

  posSessionsOpened   PosSession[]               @relation("PosSessionOpenedBy")
  posSessionsClosed   PosSession[]               @relation("PosSessionClosedBy")
  posCashMovements    PosCashMovement[]
  posCashCounts       PosCashDenominationCount[]
  posDayEndsSubmitted PosDayEnd[]                @relation("PosDayEndSubmittedBy")
  posDayEndsApproved  PosDayEnd[]                @relation("PosDayEndApprovedBy")
  posPaymentsCreated  PosPayment[]               @relation("PosPaymentCreatedBy")

  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Supplier {
  id               String   @id @default(uuid()) @db.Char(36)
  code             String   @unique
  name             String
  phone            String?
  email            String?
  address          String?
  taxId            String?
  paymentTermsDays Int      @default(0)
  creditLimit      Decimal? @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  goodsReceipts GoodsReceipt[]

  @@index([name])
  @@index([isActive])
}

model Ingredient {
  id               String      @id @default(uuid()) @db.Char(36)
  name             String
  brand            String?
  imageUrl         String?     @db.VarChar(1000)
  packageQty       Decimal     @db.Decimal(12, 3)
  packageUnit      PackageUnit
  baseQty          Decimal     @db.Decimal(12, 3)
  baseUnit         BaseUnit
  lowStockAlertQty Decimal?    @db.Decimal(12, 3)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  carterItems            PurchaseCarterItem[]
  goodsReceiptItems      GoodsReceiptItem[]
  stockLots              IngredientStockLot[]
  stockMovements         StockMovement[]
  recipeItems            ProductRecipeItem[]
  fifoConsumptions       SaleItemFifoConsumption[]
  productionConsumptions ProductionConsumption[]

  @@index([name])
  @@index([brand])
  @@index([isActive])
}

model PurchaseCarter {
  id           String   @id @default(uuid()) @db.Char(36)
  carterNo     String   @unique
  purchasedAt  DateTime
  supplierName String?
  notes        String?
  createdById  String?  @db.Char(36)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?                @relation("CarterCreatedBy", fields: [createdById], references: [id])
  items     PurchaseCarterItem[]
}

model PurchaseCarterItem {
  id              String   @id @default(uuid()) @db.Char(36)
  carterId        String   @db.Char(36)
  ingredientId    String   @db.Char(36)
  loadedQty       Decimal  @db.Decimal(12, 3)
  pricePerPackage Decimal  @db.Decimal(12, 2)
  totalBaseQty    Decimal  @db.Decimal(12, 3)
  totalPrice      Decimal  @db.Decimal(12, 2)
  unitCostBase    Decimal  @db.Decimal(12, 6)
  createdAt       DateTime @default(now())

  carter     PurchaseCarter       @relation(fields: [carterId], references: [id], onDelete: Cascade)
  ingredient Ingredient           @relation(fields: [ingredientId], references: [id])
  stockLots  IngredientStockLot[]

  @@index([carterId])
  @@index([ingredientId])
}

model GoodsReceipt {
  id                String             @id @default(uuid()) @db.Char(36)
  grnNo             String             @unique
  supplierId        String             @db.Char(36)
  supplierInvoiceNo String?
  invoiceDate       DateTime?
  receivedAt        DateTime
  status            GoodsReceiptStatus @default(DRAFT)
  notes             String?
  subtotal          Decimal            @default(0) @db.Decimal(14, 2)
  createdById       String             @db.Char(36)
  postedById        String?            @db.Char(36)
  postedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy  User?              @relation("GoodsReceiptPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  items     GoodsReceiptItem[]

  @@unique([supplierId, supplierInvoiceNo])
  @@index([supplierId])
  @@index([receivedAt])
  @@index([status])
}

model GoodsReceiptItem {
  id                 String    @id @default(uuid()) @db.Char(36)
  goodsReceiptId     String    @db.Char(36)
  ingredientId       String    @db.Char(36)
  orderedPackageQty  Decimal?  @db.Decimal(12, 3)
  receivedPackageQty Decimal   @db.Decimal(12, 3)
  acceptedBaseQty    Decimal   @db.Decimal(12, 3)
  rejectedBaseQty    Decimal   @default(0) @db.Decimal(12, 3)
  pricePerPackage    Decimal   @db.Decimal(14, 2)
  totalPrice         Decimal   @db.Decimal(14, 2)
  unitCostBase       Decimal   @db.Decimal(14, 6)
  lotNumber          String?
  expiryDate         DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  goodsReceipt GoodsReceipt        @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  ingredient   Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  stockLot     IngredientStockLot?

  @@index([goodsReceiptId])
  @@index([ingredientId])
  @@index([expiryDate])
}

model IngredientStockLot {
  id                 String    @id @default(uuid()) @db.Char(36)
  carterItemId       String?   @db.Char(36)
  goodsReceiptItemId String?   @unique @db.Char(36)
  ingredientId       String    @db.Char(36)
  receivedBaseQty    Decimal   @db.Decimal(12, 3)
  remainingBaseQty   Decimal   @db.Decimal(12, 3)
  baseUnit           BaseUnit
  unitCostBase       Decimal   @db.Decimal(12, 6)
  receivedAt         DateTime  @default(now())
  lotNumber          String?
  expiryDate         DateTime?

  carterItem             PurchaseCarterItem?       @relation(fields: [carterItemId], references: [id], onDelete: Cascade)
  goodsReceiptItem       GoodsReceiptItem?         @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  ingredient             Ingredient                @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  stockMovements         StockMovement[]
  fifoConsumptions       SaleItemFifoConsumption[]
  productionConsumptions ProductionConsumption[]

  @@index([ingredientId, remainingBaseQty])
  @@index([receivedAt])
  @@index([expiryDate])
  @@index([lotNumber])
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Char(36)
  ingredientId String            @db.Char(36)
  stockLotId   String?           @db.Char(36)
  movementType StockMovementType
  refType      String?
  refId        String?
  qtyDelta     Decimal           @db.Decimal(12, 3)
  unitCostBase Decimal?          @db.Decimal(12, 6)
  costAmount   Decimal?          @db.Decimal(12, 2)
  note         String?
  occurredAt   DateTime          @default(now())

  ingredient Ingredient          @relation(fields: [ingredientId], references: [id])
  stockLot   IngredientStockLot? @relation(fields: [stockLotId], references: [id])

  @@index([ingredientId])
  @@index([movementType])
  @@index([occurredAt])
  @@index([refType, refId])
}

model Product {
  id String @id @default(uuid()) @db.Char(36)

  officialSiteProductId Int? @unique

  name        String
  variantName String?
  imageUrl    String? @db.VarChar(1000)
  sellPrice   Decimal @db.Decimal(12, 2)

  finishedStockAlertQty Decimal? @db.Decimal(12, 3)

  isActive Boolean @default(true)

  officialSiteSyncedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  recipeItems                   ProductRecipeItem[]
  saleItems                     SaleItem[]
  productionBatches             ProductionBatch[]
  finishedGoodsLots             FinishedGoodsLot[]
  finishedGoodsMovements        FinishedGoodsMovement[]
  saleFinishedGoodsConsumptions SaleFinishedGoodsConsumption[]

  @@index([name])
  @@index([isActive])
  @@index([officialSiteProductId])
}

model ProductRecipeItem {
  id              String   @id @default(uuid()) @db.Char(36)
  productId       String   @db.Char(36)
  ingredientId    String   @db.Char(36)
  imageUrl        String?  @db.VarChar(1000)
  requiredBaseQty Decimal  @db.Decimal(12, 3)
  baseUnit        BaseUnit
  createdAt       DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model ProductionBatch {
  id                  String           @id @default(uuid()) @db.Char(36)
  batchNo             String           @unique
  productId           String           @db.Char(36)
  plannedQty          Decimal          @db.Decimal(12, 3)
  producedQty         Decimal          @default(0) @db.Decimal(12, 3)
  rejectedQty         Decimal          @default(0) @db.Decimal(12, 3)
  status              ProductionStatus @default(DRAFT)
  productionDate      DateTime         @default(now())
  expiryDate          DateTime?
  ingredientCostTotal Decimal          @default(0) @db.Decimal(14, 2)
  unitCost            Decimal          @default(0) @db.Decimal(14, 6)
  notes               String?
  createdById         String           @db.Char(36)
  postedById          String?          @db.Char(36)
  postedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  product          Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy        User                    @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy         User?                   @relation("ProductionPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  consumptions     ProductionConsumption[]
  finishedGoodsLot FinishedGoodsLot?

  @@index([productId])
  @@index([productionDate])
  @@index([status])
}

model ProductionConsumption {
  id                String   @id @default(uuid()) @db.Char(36)
  productionBatchId String   @db.Char(36)
  ingredientId      String   @db.Char(36)
  stockLotId        String   @db.Char(36)
  consumedBaseQty   Decimal  @db.Decimal(12, 3)
  unitCostBase      Decimal  @db.Decimal(14, 6)
  costAmount        Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  productionBatch ProductionBatch    @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  ingredient      Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  stockLot        IngredientStockLot @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([productionBatchId])
  @@index([ingredientId])
  @@index([stockLotId])
}

model FinishedGoodsLot {
  id                String    @id @default(uuid()) @db.Char(36)
  productionBatchId String    @unique @db.Char(36)
  productId         String    @db.Char(36)
  producedQty       Decimal   @db.Decimal(12, 3)
  remainingQty      Decimal   @db.Decimal(12, 3)
  unitCost          Decimal   @db.Decimal(14, 6)
  producedAt        DateTime
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())

  productionBatch  ProductionBatch                @relation(fields: [productionBatchId], references: [id], onDelete: Restrict)
  product          Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements        FinishedGoodsMovement[]
  saleConsumptions SaleFinishedGoodsConsumption[]

  @@index([productId, remainingQty])
  @@index([producedAt])
  @@index([expiryDate])
}

model FinishedGoodsMovement {
  id           String                    @id @default(uuid()) @db.Char(36)
  productId    String                    @db.Char(36)
  stockLotId   String?                   @db.Char(36)
  movementType FinishedGoodsMovementType
  refType      String?
  refId        String?
  qtyDelta     Decimal                   @db.Decimal(12, 3)
  unitCost     Decimal?                  @db.Decimal(14, 6)
  costAmount   Decimal?                  @db.Decimal(14, 2)
  note         String?
  occurredAt   DateTime                  @default(now())

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLot FinishedGoodsLot? @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([stockLotId])
  @@index([movementType])
  @@index([occurredAt])
  @@index([refType, refId])
}

model SalesChannel {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]
}

model SalesOrder {
  id                    String             @id @default(uuid()) @db.Char(36)
  orderNo               String             @unique
  salesChannelId        String?            @db.Char(36)
  posSessionId          String?            @db.Char(36)
  saleType              SaleType           @default(POS)
  paymentMethod         PaymentMethod      @default(CASH)
  grossTotal            Decimal            @default(0) @db.Decimal(12, 2)
  discountTotal         Decimal            @default(0) @db.Decimal(12, 2)
  netTotal              Decimal            @default(0) @db.Decimal(12, 2)
  cogsTotal             Decimal            @default(0) @db.Decimal(12, 2)
  profitTotal           Decimal            @default(0) @db.Decimal(12, 2)
  status                SaleStatus         @default(COMPLETED)
  createdById           String?            @db.Char(36)
  officialCustomerId    Int?
  customerNameSnapshot  String?            @db.VarChar(191)
  customerPhoneSnapshot String?            @db.VarChar(32)
  customerEmailSnapshot String?            @db.VarChar(191)
  receiptEmail          String?            @db.VarChar(191)
  receiptEmailStatus    ReceiptEmailStatus @default(NOT_REQUESTED)
  receiptEmailSentAt    DateTime?
  receiptEmailLastError String?            @db.VarChar(1000)
  idempotencyKey        String?            @unique @db.VarChar(191)
  originalSaleId        String?            @db.Char(36)
  reversalReason        String?            @db.VarChar(500)
  reversedAt            DateTime?
  soldAt                DateTime           @default(now())
  createdAt             DateTime           @default(now())

  salesChannel SalesChannel? @relation(fields: [salesChannelId], references: [id])
  createdBy    User?         @relation("SaleCreatedBy", fields: [createdById], references: [id])
  posSession   PosSession?   @relation(fields: [posSessionId], references: [id], onDelete: Restrict)

  originalSale SalesOrder?  @relation("SaleReversal", fields: [originalSaleId], references: [id], onDelete: Restrict)
  reversals    SalesOrder[] @relation("SaleReversal")

  items        SaleItem[]
  payments     PosPayment[]
  posApprovals PosApproval[]

  @@index([posSessionId])
  @@index([officialCustomerId])
  @@index([originalSaleId])
  @@index([soldAt])
  @@index([status])
}

model SaleItem {
  id            String   @id @default(uuid()) @db.Char(36)
  salesOrderId  String   @db.Char(36)
  productId     String   @db.Char(36)
  qty           Decimal  @db.Decimal(12, 3)
  unitSellPrice Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  discountTotal Decimal  @default(0) @db.Decimal(12, 2)
  netTotal      Decimal  @default(0) @db.Decimal(12, 2)
  cogsTotal     Decimal  @default(0) @db.Decimal(12, 2)
  profitTotal   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  salesOrder                SalesOrder                     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product                   Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  fifoConsumptions          SaleItemFifoConsumption[]
  finishedGoodsConsumptions SaleFinishedGoodsConsumption[]

  @@index([salesOrderId])
  @@index([productId])
}

model SaleItemFifoConsumption {
  id              String   @id @default(uuid()) @db.Char(36)
  saleItemId      String   @db.Char(36)
  stockLotId      String   @db.Char(36)
  ingredientId    String   @db.Char(36)
  consumedBaseQty Decimal  @db.Decimal(12, 3)
  unitCostBase    Decimal  @db.Decimal(12, 6)
  costAmount      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  saleItem   SaleItem           @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  stockLot   IngredientStockLot @relation(fields: [stockLotId], references: [id])
  ingredient Ingredient         @relation(fields: [ingredientId], references: [id])

  @@index([saleItemId])
  @@index([stockLotId])
  @@index([ingredientId])
}

model SaleFinishedGoodsConsumption {
  id                 String   @id @default(uuid()) @db.Char(36)
  saleItemId         String   @db.Char(36)
  finishedGoodsLotId String   @db.Char(36)
  productId          String   @db.Char(36)
  consumedQty        Decimal  @db.Decimal(12, 3)
  unitCost           Decimal  @db.Decimal(14, 6)
  costAmount         Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now())

  saleItem         SaleItem         @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  finishedGoodsLot FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id], onDelete: Restrict)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@index([finishedGoodsLotId])
  @@index([productId])
}

/**
 * Backend-authoritative normal weekly shop schedule.
 * weekday uses ISO-8601:
 * Monday = 1
 * ...
 * Sunday = 7
 * openingTime/closingTime use HH:mm.
 */
model BusinessWeeklySchedule {
  id          String   @id @default(uuid()) @db.Char(36)
  weekday     Int      @unique @db.UnsignedTinyInt
  isOpen      Boolean  @default(true)
  openingTime String?  @db.VarChar(5)
  closingTime String?  @db.VarChar(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Date-specific shop-calendar override.
 * CLOSED ignores opening/closing times.
 * SPECIAL_HOURS requires opening/closing times at application level.
 */
model BusinessCalendarException {
  id          String                        @id @default(uuid()) @db.Char(36)
  date        DateTime                      @unique @db.Date
  type        BusinessCalendarExceptionType
  openingTime String?                       @db.VarChar(5)
  closingTime String?                       @db.VarChar(5)
  reason      String?                       @db.VarChar(500)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([type])
}

/**
 * POS business session.
 * Sales are only allowed against an OPEN session.
 * Calendar date and business date are intentionally separate concepts.
 */
model PosSession {
  id               String           @id @default(uuid()) @db.Char(36)
  sessionNo        String           @unique
  businessDate     DateTime         @db.Date
  status           PosSessionStatus @default(OPEN)
  openedById       String           @db.Char(36)
  openedAt         DateTime         @default(now())
  openingFloat     Decimal          @default(0) @db.Decimal(14, 2)
  openingNote      String?          @db.VarChar(500)
  closingStartedAt DateTime?
  closedById       String?          @db.Char(36)
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  openedBy User  @relation("PosSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy User? @relation("PosSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  salesOrders   SalesOrder[]
  cashMovements PosCashMovement[]
  cashCounts    PosCashDenominationCount[]
  dayEnd        PosDayEnd?

  @@index([businessDate])
  @@index([status])
  @@index([openedById, status])
}

/**
 * Normalized financial payment ledger.
 * SalesOrder.paymentMethod remains temporarily for historical/backward
 * compatibility. New production POS posting will use PosPayment as the
 * authoritative payment evidence.
 */
model PosPayment {
  id             String           @id @default(uuid()) @db.Char(36)
  paymentNo      String           @unique
  salesOrderId   String           @db.Char(36)
  method         PaymentMethod
  status         PosPaymentStatus @default(COMPLETED)
  amount         Decimal          @db.Decimal(14, 2)
  tenderedAmount Decimal?         @db.Decimal(14, 2)
  changeAmount   Decimal?         @db.Decimal(14, 2)
  reference      String?          @db.VarChar(191)
  idempotencyKey String?          @unique @db.VarChar(191)
  createdById    String?          @db.Char(36)
  completedAt    DateTime?
  voidedAt       DateTime?
  createdAt      DateTime         @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("PosPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([method])
  @@index([status])
  @@index([createdAt])
}

/**
 * Non-sale physical cash movement.
 * Examples:
 * - opening float
 * - authorized cash in
 * - authorized cash out
 * - cash refund
 * - controlled adjustment
 */
model PosCashMovement {
  id           String              @id @default(uuid()) @db.Char(36)
  posSessionId String              @db.Char(36)
  type         PosCashMovementType
  amount       Decimal             @db.Decimal(14, 2)
  reason       String?             @db.VarChar(500)
  reference    String?             @db.VarChar(191)
  createdById  String              @db.Char(36)
  occurredAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  posSession PosSession @relation(fields: [posSessionId], references: [id], onDelete: Restrict)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([posSessionId, occurredAt])
  @@index([type])
}

/**
 * Physical denomination evidence.
 * We store the denomination value on the historical count itself rather
 * than depending on a future configuration table. This keeps old day-end
 * evidence accurate even if accepted denominations change later.
 */
model PosCashDenominationCount {
  id                String       @id @default(uuid()) @db.Char(36)
  posSessionId      String       @db.Char(36)
  countType         PosCountType
  denominationValue Decimal      @db.Decimal(14, 2)
  quantity          Int          @default(0) @db.UnsignedInt
  amount            Decimal      @db.Decimal(14, 2)
  countedById       String       @db.Char(36)
  countedAt         DateTime     @default(now())
  createdAt         DateTime     @default(now())

  posSession PosSession @relation(fields: [posSessionId], references: [id], onDelete: Restrict)
  countedBy  User       @relation(fields: [countedById], references: [id], onDelete: Restrict)

  @@unique([posSessionId, countType, denominationValue])
  @@index([posSessionId, countType])
}

/**
 * Immutable-style day-end financial snapshot.
 * Totals are calculated by the backend from authoritative sale/payment/
 * cash-movement records when the day end is submitted.
 */
model PosDayEnd {
  id                String       @id @default(uuid()) @db.Char(36)
  posSessionId      String       @unique @db.Char(36)
  status            DayEndStatus @default(DRAFT)
  grossSalesTotal   Decimal      @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal      @default(0) @db.Decimal(14, 2)
  netSalesTotal     Decimal      @default(0) @db.Decimal(14, 2)
  cashSalesTotal    Decimal      @default(0) @db.Decimal(14, 2)
  cardSalesTotal    Decimal      @default(0) @db.Decimal(14, 2)
  bankTransferTotal Decimal      @default(0) @db.Decimal(14, 2)
  otherPaymentTotal Decimal      @default(0) @db.Decimal(14, 2)
  refundTotal       Decimal      @default(0) @db.Decimal(14, 2)
  voidTotal         Decimal      @default(0) @db.Decimal(14, 2)
  cashInTotal       Decimal      @default(0) @db.Decimal(14, 2)
  cashOutTotal      Decimal      @default(0) @db.Decimal(14, 2)
  expectedCash      Decimal      @default(0) @db.Decimal(14, 2)
  countedCash       Decimal      @default(0) @db.Decimal(14, 2)
  variance          Decimal      @default(0) @db.Decimal(14, 2)
  invoiceCount      Int          @default(0) @db.UnsignedInt
  varianceReason    String?      @db.VarChar(500)
  cashierNote       String?      @db.VarChar(500)
  managerNote       String?      @db.VarChar(500)
  submittedById     String?      @db.Char(36)
  submittedAt       DateTime?
  approvedById      String?      @db.Char(36)
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  posSession PosSession @relation(fields: [posSessionId], references: [id], onDelete: Restrict)

  submittedBy User? @relation("PosDayEndSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("PosDayEndApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([submittedAt])
  @@index([approvedAt])
}

model DocumentSequence {
  key       String   @id
  prefix    String
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @db.Char(36)
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PosApproval {
  id     String            @id @default(uuid()) @db.Char(36)
  type   PosApprovalType
  status PosApprovalStatus @default(PENDING)

  requestedById String  @db.Char(36)
  approvedById  String? @db.Char(36)
  saleId        String? @db.Char(36)

  amount      Decimal? @db.Decimal(12, 2)
  reason      String?  @db.VarChar(500)
  contextJson Json?

  expiresAt  DateTime
  approvedAt DateTime?
  usedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy User        @relation("PosApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("PosApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  sale        SalesOrder? @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([requestedById])
  @@index([approvedById])
  @@index([saleId])
  @@index([status])
  @@index([type])
  @@index([expiresAt])
}

model BackupSetting {
  id                      String          @id @default(uuid())
  frequency               BackupFrequency @default(MANUAL)
  localBackupEnabled      Boolean         @default(true)
  localBackupPath         String          @default("./backups")
  googleDriveEnabled      Boolean         @default(false)
  googleAccountEmail      String?
  googleDriveFolderId     String?
  googleDriveRefreshToken String?
  googleDriveAccessToken  String?
  googleDriveTokenExpiry  DateTime?
  googleDriveConnectedAt  DateTime?
  googleOauthState        String?
  lastBackupAt            DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model BackupHistory {
  id                 String       @id @default(uuid())
  target             BackupTarget
  status             BackupStatus @default(RUNNING)
  fileName           String?
  filePath           String?
  googleDriveFileId  String?
  googleAccountEmail String?
  sizeBytes          Int?
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime     @default(now())
}
